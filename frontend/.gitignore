# ==============================================================================
# Frontend (Next.js / TypeScript / React) .gitignore
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build & production outputs
/.next/
/out/
/build
/dist/

# Testing & Coverage
/coverage

# Environment variables
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Debug and runtime logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Vercel & Turbopack
.vercel
.turbo

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Linter cache
.eslintcache

# Editor & IDE artifacts
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
*.pem
Thumbs.db
Desktop.ini
